{
  "name": "tm-clone",
  "private": true,
  "version": "1.0.0",
  "description": "A local, in-browser clone of the Teachable Machine image project: transfer learning on a frozen MobileNet V2.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-model": "node scripts/fetch-mobilenet.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
